# FORENSIQ Environment Variables
# Copy this file to .env and fill in your real values.

# PostgreSQL connection string (Neon, Supabase, or any Postgres provider)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-to-a-random-32-plus-char-string

# NextAuth.js URL (the public URL of your deployment)
NEXTAUTH_URL=http://localhost:3000
